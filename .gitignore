# ──────────────────────────────────────────────────────────────
# Knee OA XAI — .gitignore
# ──────────────────────────────────────────────────────────────

# ── Dataset (large, downloaded separately — see DATASET_SETUP.md) ──
data/
dataset/

# ── Virtual environment ────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Model checkpoints (large binary files) ───────────────────
outputs/models/*.pth
outputs/models/*.pt
outputs/models/*.ckpt

# ── Python cache ──────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo

# ── Jupyter / IPython ─────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── macOS ─────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ── IDE / editors ─────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Scratch / temp outputs from audit script ──────────────────
src/preprocessing/outputs/

# ── Large CSV inventory (regenerated by audit script) ─────────
outputs/metrics/full_inventory.csv
reports/stage1/full_inventory.csv

# ── Torch hub cache ───────────────────────────────────────────
~/.cache/torch/

# ── Logs ──────────────────────────────────────────────────────
*.log
logs/
