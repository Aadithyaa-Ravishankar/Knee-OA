# ──────────────────────────────────────────────────────────────
# Knee OA XAI — .gitignore
# ──────────────────────────────────────────────────────────────

# ── Dataset (large, downloaded separately — see DATASET_SETUP.md) ──
data/
dataset/

# ── Virtual environment ────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Model checkpoints (large binary files) ───────────────────
outputs/models/*.pth
outputs/models/*.pt
outputs/models/*.ckpt
# Allow the Stage-6 champion only (tracked via Git LFS)
!outputs/models/CHAMPION_stage6_cascade.pth

# ── Combined dataset (rebuild locally) ───────────────────────
Dataset_combined/
Dataset/

# ── Failed / experimental stage reports (optional local only) ─
reports/stage4b/
reports/stage7/
reports/stage8/
reports/stage9a/
reports/stage9b/

# ── Python cache ──────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo

# ── Jupyter / IPython ─────────────────────────────────────────
.ipynb_checkpoints/
# Ignore local notebooks; keep the Kaggle train notebook tracked
notebooks/**/*.ipynb
*.ipynb
!kaggle/**/*.ipynb

# ── macOS ─────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ── IDE / editors ─────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Scratch / temp outputs from audit script ──────────────────
src/preprocessing/outputs/

# ── Large CSV inventory (regenerated by audit script) ─────────
outputs/metrics/full_inventory.csv
reports/stage1/full_inventory.csv

# ── Torch hub cache ───────────────────────────────────────────
~/.cache/torch/

# ── Kaggle upload zips + local CV run caches ──────────────────
kaggle/bundle/
outputs/cv/runs/
outputs/cv/smoke/

# ── Logs ──────────────────────────────────────────────────────
*.log
logs/
